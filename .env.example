# Supabase — https://supabase.com → New project → Settings → API
# Copy Project URL + anon public key, then replace the placeholders below.
# Until real values are set, the app uses local fallback (no cloud writes).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only tools only (never expose to the browser / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: restrict admin UI hints
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_ID=
