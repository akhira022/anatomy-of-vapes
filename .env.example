# Supabase — https://supabase.com → New project → Settings → API
# Copy Project URL + anon public key, then replace the placeholders below.
# Until real values are set, the app uses local fallback (no cloud writes).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only tools only (never expose to the browser / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: restrict admin UI hints
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_ID=

# AI Chat (server-only — never NEXT_PUBLIC_*)
GEMINI_API_KEY=
# Optional: override model (default tries gemini-3.6-flash, then gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional fallback when Google project is blocked (403 denied access)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash
# OPENROUTER_SITE_URL=https://your-deployed-domain.vercel.app

# Optional: rate limit per 10 minutes per session/IP
# CHAT_RATE_LIMIT_PER_10MIN=10
